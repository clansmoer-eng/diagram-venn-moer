<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Diagram Venn Interaktif - Soal 5 PD II</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f4f6f9;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
      color: #333;
    }
    .container {
      background: #ffffff;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      max-width: 800px;
      width: 100%;
    }
    h2 {
      text-align: center;
      color: #1a365d;
      margin-bottom: 5px;
    }
    p.subtitle {
      text-align: center;
      color: #666;
      margin-bottom: 20px;
      font-size: 0.95em;
    }
    svg {
      width: 100%;
      height: 420px;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      background-color: #fafafa;
    }
    /* Style Himpunan */
    .set-shape {
      transition: all 0.3s ease;
      cursor: pointer;
      stroke-width: 2.5;
    }
    .set-shape:hover {
      filter: drop-shadow(0 0 6px rgba(0,0,0,0.3));
      stroke-width: 3.5;
    }
    /* Warna Himpunan */
    .set-toccoa { fill: rgba(66, 153, 225, 0.25); stroke: #3182ce; }
    .set-market { fill: rgba(72, 187, 120, 0.25); stroke: #38a169; }
    .set-101    { fill: rgba(237, 137, 54, 0.5);  stroke: #dd6b20; }
    .set-arnhem { fill: rgba(159, 122, 234, 0.35); stroke: #805ad5; }

    /* Irisan Kunci (Highlight) */
    .highlight-irisan {
      fill: rgba(236, 201, 75, 0.85);
      stroke: #d69e2e;
      stroke-width: 2;
      animation: pulse 2s infinite alternate;
    }

    @keyframes pulse {
      0% { fill-opacity: 0.6; }
      100% { fill-opacity: 0.95; }
    }

    .label {
      font-size: 13px;
      font-weight: bold;
      pointer-events: none;
      user-select: none;
    }
    
    /* Panel Info Interaktif */
    .info-box {
      margin-top: 20px;
      padding: 15px;
      background-color: #ebf8ff;
      border-left: 5px solid #3182ce;
      border-radius: 4px;
      min-height: 60px;
    }
    .info-title {
      font-weight: bold;
      color: #2b6cb0;
      margin-bottom: 5px;
    }
    .info-desc {
      font-size: 0.95em;
      color: #2d3748;
      line-height: 1.4;
    }
    .legend {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      margin-top: 15px;
    }
    .legend-item {
      display: flex;
      align-items: center;
      font-size: 0.85em;
      cursor: pointer;
    }
    .legend-color {
      width: 16px;
      height: 16px;
      border-radius: 3px;
      margin-right: 6px;
    }
  </style>
</head>
<body>

<div class="container">
  <h2>Diagram Venn Interaktif (Soal Nomor 5)</h2>
  <p class="subtitle">Arahkan kursor / klik pada area diagram untuk melihat detail penjelasan logika!</p>

  <svg viewBox="0 0 700 400" id="vennSvg">
    <circle cx="280" cy="200" r="170" class="set-shape set-toccoa" id="shapeToccoa" />
    
    <circle cx="260" cy="200" r="120" class="set-shape set-market" id="shapeMarket" />
    
    <circle cx="230" cy="200" r="65" class="set-shape set-101" id="shape101" />

    <circle cx="480" cy="200" r="125" class="set-shape set-arnhem" id="shapeArnhem" />

    <path d="M 373.5,123.5 A 170,170 0 0,1 373.5,276.5 A 125,125 0 0,1 373.5,123.5 Z" 
          class="set-shape highlight-irisan" id="shapeIrisan" />

    <text x="130" y="70" fill="#2b6cb0" class="label">Himpunan B: Dilatih di Camp Toccoa</text>
    <text x="160" y="110" fill="#276749" class="label">Himpunan C: Operasi Market Garden</text>
    <text x="180" y="205" fill="#7b341e" class="label">Himpunan A:</text>
    <text x="180" y="220" fill="#7b341e" class="label">Divisi 101</text>
    
    <text x="490" y="100" fill="#553c9a" class="label">Himpunan D:</text>
    <text x="490" y="118" fill="#553c9a" class="label">Diterjunkan di Arnhem</text>

    <text x="390" y="195" fill="#744210" class="label" font-size="16">★</text>
    <text x="365" y="215" fill="#744210" class="label" font-size="11">Irisan Kesimpulan</text>
  </svg>

  <div class="legend">
    <div class="legend-item" onclick="triggerHover('shapeToccoa')">
      <div class="legend-color" style="background: #3182ce;"></div> B: Camp Toccoa
    </div>
    <div class="legend-item" onclick="triggerHover('shapeMarket')">
      <div class="legend-color" style="background: #38a169;"></div> C: Market Garden
    </div>
    <div class="legend-item" onclick="triggerHover('shape101')">
      <div class="legend-color" style="background: #dd6b20;"></div> A: Divisi 101
    </div>
    <div class="legend-item" onclick="triggerHover('shapeArnhem')">
      <div class="legend-color" style="background: #805ad5;"></div> D: Diterjunkan di Arnhem
    </div>
    <div class="legend-item" onclick="triggerHover('shapeIrisan')">
      <div class="legend-color" style="background: #d69e2e;"></div> ★ Irisan Kesimpulan
    </div>
  </div>

  <div class="info-box" id="infoBox">
    <div class="info-title" id="infoTitle">Petunjuk Interaktif</div>
    <div class="info-desc" id="infoDesc">
      Arahkan tetikus (hover) atau sentuh area elemen diagram di atas untuk membaca analisis relasi logika antar-premis.
    </div>
  </div>
</div>

<script>
  const infoData = {
    shapeToccoa: {
      title: "Premis 1 (Himpunan B - Camp Toccoa)",
      desc: "Semua prajurit Divisi Udara ke-101 dilatih di Camp Toccoa. Oleh karena itu, himpunan Camp Toccoa memuat seluruh anggota Divisi 101 di dalamnya."
    },
    shapeMarket: {
      title: "Premis 2 (Himpunan C - Operasi Market Garden)",
      desc: "Semua prajurit Divisi Udara ke-101 ikut serta dalam Operasi Market Garden. Himpunan ini menaungi seluruh Divisi 101."
    },
    shape101: {
      title: "Premis 1 & 2 (Himpunan A - Divisi Udara ke-101)",
      desc: "Berada sepenuhnya di dalam Himpunan Camp Toccoa (B) dan Himpunan Market Garden (C) karena keterikatan universal 'Semua'."
    },
    shapeArnhem: {
      title: "Premis 3 (Himpunan D - Diterjunkan di Arnhem)",
      desc: "Sebagian prajurit yang dilatih di Camp Toccoa diterjunkan di Arnhem. Menunjukkan adanya irisan antara Himpunan D dan Himpunan B."
    },
    shapeIrisan: {
      title: "KESIMPULAN LOGIS (★ Irisan Kunci)",
      desc: "<b>'Sebagian prajurit yang ikut serta dalam Operasi Market Garden diterjunkan di Arnhem.'</b><br>Karena seluruh anggota yang ada di wilayah Camp Toccoa identik/termasuk peserta Operasi Market Garden, maka area irisan ini membuktikan kesimpulan C benar."
    }
  };

  const infoTitle = document.getElementById('infoTitle');
  const infoDesc = document.getElementById('infoDesc');

  function updateInfo(id) {
    if (infoData[id]) {
      infoTitle.innerHTML = infoData[id].title;
      infoDesc.innerHTML = infoData[id].desc;
    }
  }

  function resetInfo() {
    infoTitle.innerHTML = "Petunjuk Interaktif";
    infoDesc.innerHTML = "Arahkan tetikus (hover) atau sentuh area elemen diagram di atas untuk membaca analisis relasi logika antar-premis.";
  }

  // Event Listeners
  Object.keys(infoData).forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener('mouseenter', () => updateInfo(id));
      el.addEventListener('mouseleave', resetInfo);
      el.addEventListener('click', () => updateInfo(id));
    }
  });

  function triggerHover(id) {
    updateInfo(id);
  }
</script>

</body>
</html>
